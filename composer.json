{
    "name": "netdust/atelier",
    "description": "atelier — the creative-sector domain layer for atelier296 clients (productions, performances, people, press kits, Backstage) on ntdst-core and ntdst-baseline. Sites override labels, fields and slugs; they never rename a post type.",
    "type": "wordpress-muplugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Stefan Vandermeulen",
            "email": "stefan@netdust.be"
        }
    ],
    "require": {
        "php": ">=8.2",
        "netdust/ntdst-core": "^5.4",
        "netdust/ntdst-baseline": "^2.13"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:netdust/ntdst-core.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:netdust/ntdst-baseline.git"
        }
    ],
    "autoload": {
        "classmap": [
            "services/",
            "shared/"
        ]
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit",
        "gate": [
            "@composer dump-autoload -q",
            "@lint",
            "@test"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6"
    }
}
