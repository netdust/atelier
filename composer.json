{
    "name": "netdust/atelier",
    "description": "atelier — the creative-sector domain layer for atelier296 clients (productions, performances, people, press kits, Backstage) on ntdst-core and ntdst-baseline. Sites override labels, fields and slugs; they never rename a post type.",
    "type": "wordpress-muplugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Stefan Vandermeulen",
            "email": "stefan@netdust.be"
        }
    ],
    "require": {
        "php": ">=8.2",
        "netdust/ntdst-core": "^5.4",
        "netdust/ntdst-baseline": "^2.16.1",
        "bacon/bacon-qr-code": "^3.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:netdust/ntdst-core.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:netdust/ntdst-baseline.git"
        }
    ],
    "autoload": {
        "classmap": [
            "services/",
            "shared/"
        ]
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit",
        "test:int": [
            "Composer\\Config::disableProcessTimeout",
            "\"$HOME/Sites/ntdst-testbed/bin/test-package\" netdust/atelier \"$(pwd)\""
        ],
        "gate": [
            "@composer show 'netdust/*'",
            "@composer dump-autoload -q",
            "@lint",
            "@test"
        ],
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "rm -f build/infection/mutation.json",
            "infection services/card/VCardBuilder.php services/presskit/KitArchiveBuilder.php services/presskit/ArchiveNameSanitizer.php --with-uncovered --threads=4 --log-verbosity=all",
            "@php bin/mutants.php"
        ],
        "mutation:diff": [
            "Composer\\Config::disableProcessTimeout",
            "infection --git-diff-lines --git-diff-base=origin/main --with-uncovered --threads=4 --log-verbosity=all"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "infection/infection": "^0.35"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
